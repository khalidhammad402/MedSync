# MedSync configuration. Copy to .env to change anything. All values are optional.
MEDSYNC_DB=medsync.db
MEDSYNC_PORT=8000
# Fix "today" for rehearsals (YYYY-MM-DD). Leave empty to use the real date.
MEDSYNC_TODAY=
# Optional AI extractor (Claude on Amazon Bedrock). OFF by default.
# Turning it on sends DE-IDENTIFIED transcript text to AWS.
USE_LLM_EXTRACTOR=false
AWS_REGION=eu-central-1
# The model (or EU inference profile) must be enabled for your AWS account in an EU region.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
